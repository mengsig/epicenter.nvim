# Generated helptags.
doc/tags

# navgraph's own index cache, at the repo root only - the fixture tree's
# .navgraph marker is committed on purpose.
/.navgraph/

# The fake navgraph/graph handler writes real, content-hashed HTML files
# under the fixture's .navgraph/ on every test run; the marker itself stays.
tests/fixtures/proj/.navgraph/graph-*.html

# The real lane's server owns everything under its fixture's .navgraph/ (its
# parse cache and its graph renders); only the root marker is committed.
tests/fixtures/real/.navgraph/*
!tests/fixtures/real/.navgraph/.gitkeep

# CI clones NavGraph here to build the binary the real lane tests against.
/navgraph-src/

*.log
